rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function memberPath(companyId, uid) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(uid);
    }

    function invitePath(companyId, inviteId) {
      return /databases/$(database)/documents/companies/$(companyId)/invites/$(inviteId);
    }

    function isCompanyMember(companyId) {
      return signedIn()
        && exists(memberPath(companyId, request.auth.uid))
        && get(memberPath(companyId, request.auth.uid)).data.status == 'active';
    }

    function role(companyId) {
      return get(memberPath(companyId, request.auth.uid)).data.role;
    }

    function memberData(companyId) {
      return get(memberPath(companyId, request.auth.uid)).data;
    }

    function permissionOverride(companyId, permission) {
      return memberData(companyId).keys().hasAny(['permissionOverrides'])
        ? memberData(companyId).permissionOverrides[permission]
        : null;
    }

    function hasRole(companyId, roles) {
      return isCompanyMember(companyId) && roles.hasAny([role(companyId)]);
    }

    function hasPermission(companyId, permission, defaultRoles) {
      return isCompanyMember(companyId)
        && permissionOverride(companyId, permission) != false
        && (
          permissionOverride(companyId, permission) == true
          || hasRole(companyId, defaultRoles)
        );
    }

    function canManageCompany(companyId) {
      return hasPermission(companyId, 'manageCompany', ['founder', 'cofounder']);
    }

    function isCompanyOwner() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function canInvite(companyId) {
      return hasPermission(companyId, 'inviteMembers', ['founder', 'cofounder']);
    }

    function canManageFinance(companyId) {
      return hasPermission(companyId, 'manageFunding', ['founder', 'cofounder', 'finance-manager']);
    }

    function canManageExpenses(companyId) {
      return hasPermission(companyId, 'manageExpenses', ['founder', 'cofounder', 'finance-manager', 'operations-manager']);
    }

    function canManageTeamPayments(companyId) {
      return hasPermission(companyId, 'manageTeamPayments', ['founder', 'cofounder', 'finance-manager', 'hr-manager']);
    }

    function canManageStartupCosts(companyId) {
      return hasPermission(companyId, 'manageStartupCosts', ['founder', 'cofounder', 'finance-manager']);
    }

    function canManageRecurringCosts(companyId) {
      return hasPermission(companyId, 'manageRecurringCosts', ['founder', 'cofounder', 'finance-manager', 'operations-manager']);
    }

    function canManageFounderNotes(companyId) {
      return hasPermission(companyId, 'manageFounderNotes', ['founder', 'cofounder', 'operations-manager']);
    }

    function canManageMembers(companyId) {
      return hasPermission(companyId, 'manageMembers', ['founder', 'cofounder']);
    }

    function canManageRoles(companyId) {
      return hasPermission(companyId, 'manageRoles', ['founder', 'cofounder']);
    }

    function isFounder(companyId) {
      return hasRole(companyId, ['founder']);
    }

    function validInviteForJoin(companyId, memberRole) {
      return request.resource.data.inviteId is string
        && exists(invitePath(companyId, request.resource.data.inviteId))
        && get(invitePath(companyId, request.resource.data.inviteId)).data.status == 'pending'
        && get(invitePath(companyId, request.resource.data.inviteId)).data.expiresAt > request.time
        && get(invitePath(companyId, request.resource.data.inviteId)).data.role == memberRole
        && memberRole != 'founder';
    }

    function profileRoleMatchesMembership(userId) {
      return request.resource.data.activeCompanyId is string
        && existsAfter(memberPath(request.resource.data.activeCompanyId, userId))
        && getAfter(memberPath(request.resource.data.activeCompanyId, userId)).data.role == request.resource.data.role;
    }

    function coreMemberFieldsUnchanged() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.invitedBy == resource.data.invitedBy;
    }

    function protectedCofounderTarget(companyId) {
      return (
        resource.data.role == 'cofounder'
        || request.resource.data.role == 'cofounder'
      )
        ? isFounder(companyId)
        : true;
    }

    function roleChangeAllowed(companyId) {
      return request.resource.data.role == resource.data.role
        || canManageRoles(companyId);
    }

    function permissionOverrideChangeAllowed(companyId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissionOverrides'])
        || canManageRoles(companyId);
    }

    function coreInviteFieldsUnchanged(companyId) {
      return request.resource.data.inviteId == resource.data.inviteId
        && request.resource.data.companyId == companyId
        && request.resource.data.token == resource.data.token
        && request.resource.data.role == resource.data.role
        && request.resource.data.invitedByUid == resource.data.invitedByUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function coreInviteLookupFieldsUnchanged() {
      return request.resource.data.inviteId == resource.data.inviteId
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.token == resource.data.token
        && request.resource.data.role == resource.data.role
        && request.resource.data.invitedByUid == resource.data.invitedByUid
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && request.resource.data.uid == userId;
      allow update: if isSelf(userId)
        && request.resource.data.uid == userId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
          || request.resource.data.role == resource.data.role
          || profileRoleMatchesMembership(userId)
        );
      allow delete: if isSelf(userId);

      match /{legacyCollection}/{docId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    match /companies/{companyId} {
      allow create: if signedIn()
        && request.resource.data.companyId == companyId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;

      allow read: if isCompanyMember(companyId);
      allow update: if canManageCompany(companyId) || isCompanyOwner();
      allow delete: if hasRole(companyId, ['founder']);

      match /members/{memberId} {
        allow read: if isCompanyMember(companyId);

        allow create: if signedIn()
          && request.resource.data.uid == memberId
          && (
            (
              memberId == request.auth.uid
              && request.resource.data.role == 'founder'
              && getAfter(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
            )
            || (
              memberId == request.auth.uid
              && request.resource.data.status == 'active'
              && validInviteForJoin(companyId, request.resource.data.role)
            )
          );

        allow update: if canManageMembers(companyId)
          && resource.data.role != 'founder'
          && request.resource.data.role != 'founder'
          && protectedCofounderTarget(companyId)
          && coreMemberFieldsUnchanged()
          && roleChangeAllowed(companyId)
          && permissionOverrideChangeAllowed(companyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'permissionOverrides', 'updatedAt']);

        allow delete: if canManageMembers(companyId)
          && resource.data.role != 'founder'
          && (
            resource.data.role != 'cofounder'
            || isFounder(companyId)
          );
      }

      match /invites/{inviteId} {
        allow get: if isCompanyMember(companyId)
          || (
            resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
          );
        allow list: if isCompanyMember(companyId);

        allow create: if canInvite(companyId)
          && request.resource.data.inviteId == inviteId
          && request.resource.data.token == inviteId
          && request.resource.data.companyId == companyId
          && request.resource.data.invitedByUid == request.auth.uid
          && request.resource.data.role != 'founder'
          && request.resource.data.status == 'pending'
          && request.resource.data.expiresAt > request.time;

        allow update: if (
            canInvite(companyId)
            && coreInviteFieldsUnchanged(companyId)
            && request.resource.data.role != 'founder'
            && request.resource.data.status == 'revoked'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            signedIn()
            && coreInviteFieldsUnchanged(companyId)
            && resource.data.status == 'pending'
            && resource.data.expiresAt > request.time
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedByUid == request.auth.uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedByUid', 'updatedAt'])
          );

        allow delete: if canInvite(companyId);
      }

      match /funding/{docId} {
        allow read: if isCompanyMember(companyId);
        allow write: if canManageFinance(companyId);
      }

      match /expenses/{docId} {
        allow read: if isCompanyMember(companyId);
        allow write: if canManageExpenses(companyId);
      }

      match /startupCosts/{docId} {
        allow read: if isCompanyMember(companyId);
        allow write: if canManageStartupCosts(companyId);
      }

      match /recurringCosts/{docId} {
        allow read: if isCompanyMember(companyId);
        allow write: if canManageRecurringCosts(companyId);
      }

      match /teamPayments/{docId} {
        allow read: if isCompanyMember(companyId);
        allow write: if canManageTeamPayments(companyId);
      }

      match /founderNotes/{docId} {
        allow read: if isCompanyMember(companyId);
        allow write: if canManageFounderNotes(companyId);
      }
    }

    match /inviteLookups/{token} {
      allow get: if (
          resource.data.status == 'pending'
          && resource.data.expiresAt > request.time
        )
        || (
          signedIn()
          && resource.data.acceptedByUid == request.auth.uid
        )
        || canInvite(resource.data.companyId);
      allow list: if signedIn()
        && (
          resource.data.acceptedByUid == request.auth.uid
          || canInvite(resource.data.companyId)
        );

      allow create: if signedIn()
        && request.resource.data.inviteId == token
        && request.resource.data.token == token
        && request.resource.data.companyId is string
        && canInvite(request.resource.data.companyId)
        && request.resource.data.invitedByUid == request.auth.uid
        && request.resource.data.role != 'founder'
        && request.resource.data.status == 'pending'
        && request.resource.data.expiresAt > request.time;

      allow update: if (
          canInvite(resource.data.companyId)
          && coreInviteLookupFieldsUnchanged()
          && request.resource.data.status == 'revoked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        )
        || (
          signedIn()
          && coreInviteLookupFieldsUnchanged()
          && resource.data.status == 'pending'
          && resource.data.expiresAt > request.time
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedByUid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedByUid', 'updatedAt'])
        )
        || (
          canInvite(resource.data.companyId)
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'inviteId',
            'companyId',
            'companyName',
            'token',
            'role',
            'invitedByUid',
            'invitedByName',
            'status',
            'expiresAt',
            'createdAt',
            'acceptedAt',
            'acceptedByUid'
          ])
        );

      allow delete: if canInvite(resource.data.companyId);
    }
  }
}
